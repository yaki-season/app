{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "order.schema.json",
  "title": "초기 캠페인 계획 주문",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "displayKey",
    "active",
    "status",
    "dayId",
    "arrivalSegmentId",
    "source",
    "customerCount",
    "items",
    "guidanceId",
    "memoryFlagIds",
    "requiresOrderCompletionIds"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^D[1-9][0-9]*-ORDER-[A-Z0-9-]+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "displayKey": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" },
    "status": { "enum": ["candidate", "approved"] },
    "dayId": { "type": "string", "pattern": "^d[1-9][0-9]*$" },
    "arrivalSegmentId": { "type": "string", "minLength": 1 },
    "runtimeCustomerId": { "type": ["string", "null"] },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "characterId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fixed-character" },
            "characterId": { "type": "string", "pattern": "^CHAR-[A-Z0-9-]+$" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "customerTypeId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "extra-type" },
            "customerTypeId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "customerCount": { "type": "integer", "minimum": 1, "maximum": 2 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["menuId", "quantity", "seasoning"],
        "additionalProperties": false,
        "properties": {
          "menuId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 12 },
          "seasoning": { "enum": ["none", "salt", "tare"] }
        }
      }
    },
    "guidanceId": { "type": ["string", "null"] },
    "memoryFlagIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiresOrderCompletionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
