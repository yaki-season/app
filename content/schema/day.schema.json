{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "day.schema.json",
  "title": "영업일",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "displayKey",
    "active",
    "status",
    "customerCount",
    "spawnIntervalSec",
    "waitRecoverySec",
    "urgentThresholdSec",
    "customerPool",
    "economy",
    "timingSec",
    "autoPolicySuccessRate",
    "businessWindow",
    "segments",
    "totals",
    "maxActiveOrders",
    "maxRiskProcesses",
    "plannedOrderIds",
    "availableMenuIds",
    "newActionId",
    "reviewActionIds",
    "tutorialPolicy",
    "settlement"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^d[1-9][0-9]*$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "displayKey": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" },
    "status": { "enum": ["candidate", "approved"] },
    "customerCount": { "type": "integer", "minimum": 1, "maximum": 200, "unit": "명" },
    "spawnIntervalSec": { "type": "number", "minimum": 1, "maximum": 120, "unit": "초" },
    "waitRecoverySec": { "type": "number", "minimum": 0, "maximum": 120, "unit": "초" },
    "urgentThresholdSec": { "type": "number", "minimum": 1, "maximum": 120, "unit": "초" },
    "customerPool": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "economy": {
      "type": "object",
      "required": ["basePrice", "qualityMultGood", "qualityMultLow", "tipBase"],
      "additionalProperties": false,
      "properties": {
        "basePrice": { "type": "number", "minimum": 0, "maximum": 1000, "unit": "G" },
        "qualityMultGood": { "type": "number", "minimum": 0, "maximum": 5, "unit": "배" },
        "qualityMultLow": { "type": "number", "minimum": 0, "maximum": 5, "unit": "배" },
        "tipBase": { "type": "number", "minimum": 0, "maximum": 200, "unit": "G" }
      }
    },
    "timingSec": {
      "type": "object",
      "required": ["assembly", "eat", "orderThinkMin", "orderThinkMax"],
      "additionalProperties": false,
      "properties": {
        "assembly": { "type": "number", "minimum": 0, "maximum": 10, "unit": "초" },
        "eat": { "type": "number", "minimum": 0, "maximum": 60, "unit": "초" },
        "orderThinkMin": { "type": "number", "minimum": 0, "maximum": 30, "unit": "초" },
        "orderThinkMax": { "type": "number", "minimum": 0, "maximum": 30, "unit": "초" }
      }
    },
    "autoPolicySuccessRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "unit": "비율"
    },
    "businessWindow": {
      "type": "object",
      "required": ["startMinute", "endMinute", "spansMidnight", "targetSessionSec"],
      "additionalProperties": false,
      "properties": {
        "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
        "endMinute": { "type": "integer", "minimum": 1, "maximum": 2879 },
        "spansMidnight": { "type": "boolean" },
        "targetSessionSec": { "type": "integer", "minimum": 360, "maximum": 480, "unit": "초" }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "startMinute",
          "endMinute",
          "customerCount",
          "orderCount",
          "itemCount",
          "maxActiveOrders",
          "maxRiskProcesses"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^d[1-9][0-9]*-[a-z0-9-]+$" },
          "startMinute": { "type": "integer", "minimum": 0, "maximum": 2879 },
          "endMinute": { "type": "integer", "minimum": 1, "maximum": 2880 },
          "customerCount": { "$ref": "#/definitions/countRange" },
          "orderCount": { "$ref": "#/definitions/countRange" },
          "itemCount": { "$ref": "#/definitions/countRange" },
          "maxActiveOrders": { "type": "integer", "minimum": 1, "maximum": 12 },
          "maxRiskProcesses": { "type": "integer", "minimum": 1, "maximum": 12 }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["customers", "orders", "items"],
      "additionalProperties": false,
      "properties": {
        "customers": { "$ref": "#/definitions/countRange" },
        "orders": { "$ref": "#/definitions/countRange" },
        "items": { "$ref": "#/definitions/countRange" }
      }
    },
    "maxActiveOrders": { "type": "integer", "minimum": 1, "maximum": 12 },
    "maxRiskProcesses": { "type": "integer", "minimum": 1, "maximum": 12 },
    "plannedOrderIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "availableMenuIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "newActionId": { "type": "string", "minLength": 1 },
    "reviewActionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tutorialPolicy": {
      "type": "object",
      "required": ["guidanceLevel", "helpCanBeReenabled", "failurePolicy"],
      "additionalProperties": false,
      "properties": {
        "guidanceLevel": { "enum": ["full", "reduced", "safe-introduction"] },
        "helpCanBeReenabled": { "type": "boolean" },
        "failurePolicy": { "enum": ["no-failure", "standard", "safe-first-use"] }
      }
    },
    "settlement": {
      "type": "object",
      "required": ["goalId", "bonusGoalIds", "growthResultIds", "nextNodeId", "rewardSource"],
      "additionalProperties": false,
      "properties": {
        "goalId": { "type": "string", "minLength": 1 },
        "bonusGoalIds": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "growthResultIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "nextNodeId": { "type": "string", "minLength": 1 },
        "rewardSource": { "const": "settlement-ledger" }
      }
    }
  },
  "definitions": {
    "countRange": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0, "maximum": 200 },
        "max": { "type": "integer", "minimum": 0, "maximum": 200 }
      }
    }
  }
}
