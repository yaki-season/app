{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recipe.schema.json",
  "title": "레시피",
  "type": "object",
  "required": ["id", "schemaVersion", "displayKey", "active", "status", "category", "ingredients"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "displayKey": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" },
    "status": { "enum": ["candidate", "approved"] },
    "category": { "type": "string", "minLength": 1 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["chicken", "leek"] }
    },
    "processId": { "type": "string" }
  }
}
