{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grill-slots.schema.json",
  "title": "그릴 칸 명성 해금",
  "type": "object",
  "required": ["id", "schemaVersion", "displayKey", "active", "status", "maxSlots", "tiers"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "displayKey": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" },
    "status": { "enum": ["candidate", "approved"] },
    "maxSlots": { "type": "integer", "minimum": 1, "maximum": 12, "description": "그릴 최대 칸 수 (GPL-005 v2.23.0: 8)." },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "description": "명성 구간별 그릴 칸 수. reputation 오름차순, 도달한 최고 구간이 적용된다.",
      "items": {
        "type": "object",
        "required": ["reputation", "slots"],
        "additionalProperties": false,
        "properties": {
          "reputation": { "type": "integer", "minimum": 0, "unit": "명성" },
          "slots": { "type": "integer", "minimum": 1, "maximum": 12, "unit": "칸" }
        }
      }
    }
  }
}
