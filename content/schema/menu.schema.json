{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "menu.schema.json",
  "title": "초기 캠페인 메뉴",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "displayKey",
    "active",
    "status",
    "category",
    "stationId",
    "introducedOn",
    "seasoningOptions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "displayKey": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" },
    "status": { "enum": ["candidate", "approved"] },
    "category": { "enum": ["skewer", "drink"] },
    "stationId": { "enum": ["assembly-grill", "drink"] },
    "introducedOn": { "enum": ["d1", "d2", "d3"] },
    "seasoningOptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "salt", "tare"] }
    }
  }
}
