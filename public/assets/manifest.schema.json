{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaki-season.local/assets/manifest.schema.json",
  "title": "YAKI SEASON runtime asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "specRefs", "packs", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "3.0.0" },
    "generatedAt": { "type": "string", "format": "date" },
    "specRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "packs": {
      "type": "object",
      "required": ["core", "campaign", "optional"],
      "properties": {
        "core": { "$ref": "#/$defs/pack" },
        "campaign": { "$ref": "#/$defs/pack" },
        "optional": { "$ref": "#/$defs/pack" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "retainedAssets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "required": ["load", "description"],
      "properties": {
        "load": { "enum": ["startup", "stage", "on-demand"] },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "url", "sha256", "bytes", "format"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "url": { "type": "string", "pattern": "^/assets/[a-z0-9./-]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "format": { "enum": ["jpeg", "png", "webp", "glb", "json"] },
        "dimensions": { "$ref": "#/$defs/dimensions" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": { "enum": ["jpeg", "png", "webp"] }
            },
            "required": ["format"]
          },
          "then": {
            "properties": { "dimensions": true },
            "required": ["dimensions"]
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "sourceRevision", "runtimeBuild", "status", "screenUnit",
        "profile", "pack", "kind", "url", "sha256", "bytes", "format",
        "colorSpace", "alpha", "lossPolicy", "pivot", "anchors", "clips",
        "mirrorSafe", "source", "provenance", "license", "specRefs", "reviewedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!.*-R[0-9]+$)[A-Z0-9-]+$"
        },
        "legacyId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
        "groupId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "runtimeBuild": { "type": "integer", "minimum": 1 },
        "status": { "const": "approved" },
        "screenUnit": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["complete-layer", "standalone-raster", "bundle-model"] },
        "pack": { "enum": ["core", "campaign", "optional"] },
        "kind": { "enum": ["image", "atlas", "model", "texture", "vfx"] },
        "url": { "type": "string", "pattern": "^/assets/[a-z0-9./-]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "bounds": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/point" },
            "max": { "$ref": "#/$defs/point" }
          },
          "additionalProperties": false
        },
        "format": { "enum": ["jpeg", "png", "webp", "glb", "json"] },
        "colorSpace": { "enum": ["sRGB", "linear", "not-applicable"] },
        "alpha": { "enum": ["none", "straight", "not-applicable"] },
        "lossPolicy": { "enum": ["lossless-required", "lossy-background-approved", "not-applicable"] },
        "pivot": { "$ref": "#/$defs/point" },
        "anchors": { "type": "array" },
        "clips": { "type": "array", "items": { "type": "string" } },
        "companions": {
          "type": "array",
          "items": { "$ref": "#/$defs/companion" }
        },
        "mirrorSafe": { "type": "boolean" },
        "source": { "type": "string", "pattern": "^ARTSRC:[A-Z0-9-]+:R[0-9]+$" },
        "provenance": { "type": "string", "pattern": "^PROV:[A-Z0-9-]+:R[0-9]+$" },
        "license": { "type": "string", "minLength": 1 },
        "specRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "reviewedAt": { "type": "string", "format": "date" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": { "enum": ["jpeg", "png", "webp"] }
            },
            "required": ["format"]
          },
          "then": {
            "required": ["dimensions"],
            "properties": { "dimensions": true }
          },
          "else": {
            "required": ["bounds"],
            "properties": { "bounds": true }
          }
        }
      ]
    }
  }
}
